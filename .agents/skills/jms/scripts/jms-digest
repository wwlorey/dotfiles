#!/usr/bin/env bash
# jms-digest — fetch the newest Jack Mallers Show episode, summarize it, and
# email the digest via the local ProtonMail Bridge.
#
# Vendor primitive: the summarization step calls `claude -p` (capability: LLM
# summarization of a transcript). A harness port rewrites only that one call.
#
# Usage:
#   jms-digest              # cron mode: discover the latest episode, send if new
#   jms-digest --retry-only # act only on a pending episode (hourly backoff job)
#   jms-digest --force      # always summarize+send the latest, print to stdout
#   jms-digest --dry-run    # build the email but print instead of sending
set -euo pipefail

# Full episodes appear in either tab: live-streamed shows land under /streams,
# pre-recorded uploads under /videos (which also carries Shorts and clips). Scan
# both and let the duration floor exclude the short stuff.
CHANNEL="https://www.youtube.com/@thejackmallersshow"
TABS=(streams videos)
MIN_DURATION=1200 # seconds (20 min) — skip Shorts and clips
SCAN_COUNT=12     # how many recent uploads to inspect per tab
TAB=$'\t'         # yt-dlp --print prints the template verbatim; use a real tab

STATE_DIR="$HOME/.local/state/jms"
STATE_FILE="$STATE_DIR/last-sent"
# Cron runs park unfinished work in this marker; the hourly --retry-only job
# drains it with exponential backoff (RETRY_BASE, doubling each time) until it
# succeeds or gives up after RETRY_CAP attempts. Two stages: "discovery" — the
# weekly run couldn't get a usable episode listing (e.g. it fired inside a
# dark-wake window on a sleeping laptop with no real network) — and "captions"
# — episode found but its auto-captions aren't published yet.
PENDING_FILE="$STATE_DIR/pending"
RETRY_BASE=3600 # first backoff step in seconds (1h); each retry doubles it
RETRY_CAP=5     # give up after this many failed retries (~31h total window)
SENDER="noreply@lorey.co"
RECIPIENT="jms@lorey.co"
# Delivery is handled by the shared send-email skill.
SEND_EMAIL="$HOME/.agents/skills/send-email/scripts/send-email.py"
FETCH_TRANSCRIPT="$HOME/.agents/skills/jms/scripts/fetch-transcript"
# Email-chat shares state here: the cached transcript (so a reply can be answered
# without refetching) and the reply-token (embedded in the digest's Message-ID).
CHAT_STATE_DIR="$HOME/.local/state/jms-chat"

FORCE=0
DRY_RUN=0
RETRY_ONLY=0
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --retry-only) RETRY_ONLY=1 ;;
    *) echo "jms-digest: unknown argument: $arg" >&2; exit 2 ;;
  esac
done

log() { echo "[jms-digest $(date '+%Y-%m-%dT%H:%M:%S')] $*" >&2; }
now_epoch() { date '+%s'; }

# Email a failure/retry notice — only for unattended (cron) runs; manual
# --force/--dry-run runs surface errors on the terminal. Best-effort: a failed
# alert never masks the original failure, but its outcome is always logged so a
# silent week stays diagnosable. Args: $1 = body detail, $2 = subject tail.
alert() {
  [ "$FORCE" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] || return 0
  [ -f "$SEND_EMAIL" ] || return 0
  local err rc=0
  err="$(printf 'The JMS digest run did not deliver a digest.\n\nReason: %s\n\n— jms-digest on %s at %s\n' \
    "$1" "$(hostname -s 2>/dev/null || echo host)" "$(date '+%Y-%m-%dT%H:%M:%S')" |
    python3 "$SEND_EMAIL" --from "$SENDER" --to "$RECIPIENT" \
      --subject "JMS digest alert: $2" 2>&1 >/dev/null)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    log "alert emailed: $2"
  else
    log "alert email FAILED (rc=$rc): $2 — $(printf '%s' "$err" | tr '\n' ' ' | head -c 200)"
  fi
  return 0
}

# Cheap connectivity probe. Cron runs that fire inside a dark-wake window (a
# laptop asleep on battery) have no usable network; probing first lets them
# defer without consuming a retry attempt or burning the weekly slot.
network_up() { curl -sf --max-time 5 -o /dev/null "https://www.gstatic.com/generate_204"; }

# Pending-work marker (JSON): what the retry job is draining. stage "discovery"
# carries empty vid/title/upload_date (no episode known yet); stage "captions"
# carries the episode the weekly run found.
write_pending() { # stage vid title upload_date first_seen attempts next_eligible
  mkdir -p "$STATE_DIR"
  jq -n --arg stage "$1" --arg vid "$2" --arg title "$3" --arg ud "$4" \
    --argjson fs "$5" --argjson at "$6" --argjson ne "$7" \
    '{stage:$stage,vid:$vid,title:$title,upload_date:$ud,first_seen:$fs,attempts:$at,next_eligible:$ne}' \
    >"$PENDING_FILE"
}
clear_pending() { rm -f "$PENDING_FILE"; }

for tool in yt-dlp claude jq python3 curl; do
  command -v "$tool" >/dev/null 2>&1 || { log "required tool not found: $tool"; exit 1; }
done

work=""
# return 0 explicitly: on macOS bash 3.2 a trap whose last command returns
# non-zero overrides an explicit `exit 0`, so a clean no-op (no pending marker,
# not yet due, already sent) would otherwise report exit 1 and pollute the logs.
cleanup() { [ -n "$work" ] && rm -rf "$work"; return 0; }
trap cleanup EXIT

# process_episode <vid> <title> <upload_date>
# Fetch captions, summarize, and email the digest for a known episode. Shared by
# the discovery path and the retry path. Returns: 0 sent (or dry-run printed);
# 10 captions not available yet; 11 summarization/delivery failed (already alerted).
process_episode() {
  local vid="$1" title="$2" upload_date="$3"
  local url="https://www.youtube.com/watch?v=${vid}"

  # Transcript via the shared fetch-transcript helper; cache it for email-chat.
  work="$(mktemp -d "${TMPDIR:-/tmp}/jms.XXXXXX")"
  local transcript="$work/transcript.txt"
  log "fetching captions for $vid"
  if ! bash "$FETCH_TRANSCRIPT" "$vid" >"$transcript" 2>/dev/null || [ ! -s "$transcript" ]; then
    log "no captions available yet for $vid"
    return 10
  fi
  mkdir -p "$CHAT_STATE_DIR"
  cp "$transcript" "$CHAT_STATE_DIR/$vid.txt" 2>/dev/null || true
  log "transcript: $(wc -l <"$transcript" | tr -d ' ') lines, $(wc -c <"$transcript" | tr -d ' ') bytes"

  # Summarize. Stream-json is used so the digest is recovered from the assistant
  # message even if a Stop hook adds a follow-up turn; sentinels bound the text.
  local prompt
  read -r -d '' prompt <<EOF || true
You are summarizing an episode of The Jack Mallers Show (Bitcoin, macroeconomics,
markets, the future of money). The transcript is auto-generated captions piped on
stdin, so punctuation and speaker labels are unreliable — infer meaning.

Episode title: ${title}
URL: ${url}
Aired (YYYYMMDD): ${upload_date}

Write the digest in plain text with TWO clearly separated parts.

Put this exact line, then PART 1: THE GIST
PART 1 is an in-depth TL;DR of roughly 6-10 sentences. A reader should finish it in
under a minute and feel fully caught up — the through-line, the main arguments, the
conclusions, and any calls to action. Richer than a one-liner, shorter than PART 2.

Then a blank line, this exact line, then PART 2: THE BREAKDOWN
PART 2 walks the episode IN THE ORDER JACK PRESENTS IT, mirroring the show's own
structure (e.g. the opening / market check, each main news item or topic in turn,
the mailbag or Q&A, Strike updates, and the close). For each segment: a short label
line, then 2-4 "- " bullets capturing the argument, the key data or claims, and any
notable quote (paraphrase if the captions are garbled).

End with a final line exactly: Watch: ${url}

Output ONLY the digest, wrapped between a line containing exactly <<<DIGEST>>> and
a line containing exactly <<<END>>>. No preamble, no markdown headers.
EOF

  # SECURITY: the transcript is untrusted (arbitrary YouTube captions). Never add
  # --dangerously-skip-permissions here — without it, non-interactive claude -p
  # auto-denies any tool call the captions might try to coerce, so the model can
  # only return text.
  log "summarizing with claude -p"
  # AGENT_HEADLESS: per LAW.md, headless agent calls declare themselves so Stop
  # hooks (voice report, orphan check) don't inject extra turns into the run.
  local raw digest
  raw="$(AGENT_HEADLESS=1 claude -p --output-format stream-json --verbose "$prompt" <"$transcript" 2>/dev/null |
    jq -r 'select(.type=="assistant") | .message.content[]? | select(.type=="text") | .text' 2>/dev/null || true)"

  digest="$(printf '%s\n' "$raw" | awk '/<<<DIGEST>>>/{f=1;next} /<<<END>>>/{f=0} f')"
  # Require the sentinels — their absence means claude -p returned something other
  # than a digest (an auth error like "Not logged in", a refusal, an empty stream).
  # Do NOT fall back to the raw text: emailing that ships the error as the digest.
  if [ -z "$digest" ]; then
    local reason="summarization produced no digest (claude -p auth/output failure — raw: $(printf '%s' "$raw" | head -c 120 | tr '\n' ' '))"
    log "$reason"
    alert "$reason" "summarization failed"
    return 11
  fi

  # Build and send the email.
  local subject="JMS digest: ${title}"
  local body
  body="$(printf '%s\n\n—\nEpisode: %s\nAired: %s\nAutomated weekly summary of The Jack Mallers Show.\n' \
    "$digest" "$url" "$upload_date")"

  if [ "$DRY_RUN" -eq 1 ]; then
    printf -- '----- DRY RUN (not sent) -----\nFrom: %s\nTo: %s\nSubject: %s\n\n%s\n' \
      "$SENDER" "$RECIPIENT" "$subject" "$body"
    return 0
  fi

  [ -f "$SEND_EMAIL" ] || { log "send-email skill not found at $SEND_EMAIL"; return 11; }
  # Encode the episode id + chat token in the Message-ID (which Proton preserves,
  # unlike Reply-To). A reply's In-Reply-To carries it, gating the email-chat
  # responder to this episode. Only set when the chat token has been created.
  local mid_args=()
  if [ -f "$CHAT_STATE_DIR/reply-token" ]; then
    local token; token="$(cat "$CHAT_STATE_DIR/reply-token")"
    mid_args=(--message-id "<jms.${vid}.${token}@lorey.co>")
  fi
  printf '%s' "$body" | python3 "$SEND_EMAIL" --from "$SENDER" --to "$RECIPIENT" --subject "$subject" ${mid_args[@]+"${mid_args[@]}"}
  log "sent digest for $vid to $RECIPIENT"

  # Record state and drop any pending marker for this episode. Manual --force runs
  # print the digest instead of moving the marker.
  clear_pending
  if [ "$FORCE" -eq 1 ]; then
    printf '%s\n' "$digest"
  else
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$vid" >"$STATE_FILE"
  fi
  return 0
}

# discover_latest — scan both tabs for the newest long-form episode. On success
# prints "duration<TAB>vid<TAB>upload_date<TAB>title" and returns 0. Returns 20
# on an empty fetch (network/yt-dlp failure), 21 when uploads were listed but
# none clear MIN_DURATION. yt-dlp's stderr is left flowing to the job log so a
# failed fetch stays diagnosable. Listings are captured before filtering — piping
# yt-dlp straight into an awk that exits early would SIGPIPE it and trip
# `set -o pipefail`.
discover_latest() {
  local listing="" tab selection
  for tab in "${TABS[@]}"; do
    listing+="$(
      yt-dlp --no-warnings --ignore-errors --playlist-end "$SCAN_COUNT" \
        --print "%(duration)s${TAB}%(id)s${TAB}%(upload_date)s${TAB}%(title)s" \
        "$CHANNEL/$tab" || true
    )"$'\n'
  done
  selection="$(
    printf '%s\n' "$listing" |
      awk -F"$TAB" -v min="$MIN_DURATION" '$1 ~ /^[0-9]+$/ && ($1 + 0) >= min' |
      sort -t"$TAB" -k3,3nr | head -n1
  )"
  if [ -z "$selection" ]; then
    [ -z "$(printf '%s' "$listing" | tr -d '[:space:]')" ] && return 20
    return 21
  fi
  printf '%s\n' "$selection"
}

# --- retry-only mode: drain pending work with exponential backoff --------------
# Cheap when idle: no pending marker means no work and no YouTube scraping.
if [ "$RETRY_ONLY" -eq 1 ]; then
  [ -f "$PENDING_FILE" ] || exit 0
  pj="$(cat "$PENDING_FILE")"
  stage="$(jq -r '.stage // "captions"' <<<"$pj")"
  vid="$(jq -r '.vid' <<<"$pj")"
  title="$(jq -r '.title' <<<"$pj")"
  upload_date="$(jq -r '.upload_date' <<<"$pj")"
  first_seen="$(jq -r '.first_seen' <<<"$pj")"
  attempts="$(jq -r '.attempts' <<<"$pj")"
  next_eligible="$(jq -r '.next_eligible' <<<"$pj")"
  now="$(now_epoch)"
  [ "$now" -ge "$next_eligible" ] || exit 0 # not yet due; stay quiet

  # No usable network (a dark-wake tick, Wi-Fi down): defer without consuming an
  # attempt — the marker stays due, so the next hourly tick tries again.
  if ! network_up; then
    log "network unreachable; deferring pending $stage retry (no attempt consumed)"
    exit 0
  fi

  # A discovery-stage marker has no episode yet: redo discovery first.
  if [ "$stage" = "discovery" ]; then
    log "retrying discovery (attempt $((attempts + 1)) of $RETRY_CAP)"
    rc=0
    selection="$(discover_latest)" || rc=$?
    if [ "$rc" -ne 0 ]; then
      attempts=$((attempts + 1))
      if [ "$attempts" -ge "$RETRY_CAP" ]; then
        window=$(((now - first_seen) / 3600))
        reason="gave up after $attempts discovery retries (~${window}h) — no usable episode listing (last rc=$rc)"
        log "$reason"
        alert "$reason" "gave up on discovery"
        clear_pending
        exit 1
      fi
      delay=$((RETRY_BASE * (1 << attempts)))
      write_pending discovery "" "" "" "$first_seen" "$attempts" "$((now + delay))"
      reason="retry $attempts/$RETRY_CAP: discovery still failing (rc=$rc); next attempt in ~$((delay / 3600))h"
      log "$reason"
      alert "$reason" "retry $attempts — discovery failing"
      exit 1
    fi
    vid="$(printf '%s' "$selection" | cut -f2)"
    upload_date="$(printf '%s' "$selection" | cut -f3)"
    title="$(printf '%s' "$selection" | cut -f4-)"
    log "discovery retry found $vid — $title ($upload_date)"
    # Stage transition gets a fresh clock: a captions failure below restarts the
    # backoff window rather than inheriting the discovery stage's attempts.
    first_seen="$now"
    attempts=0
  fi

  # A weekly run may have already sent this episode; don't double-send.
  if [ -f "$STATE_FILE" ] && [ "$(cat "$STATE_FILE")" = "$vid" ]; then
    log "episode $vid already sent; clearing pending"
    clear_pending; exit 0
  fi

  log "retry for pending $vid (attempt $((attempts + 1)) of $RETRY_CAP)"
  rc=0
  process_episode "$vid" "$title" "$upload_date" || rc=$?
  [ "$rc" -eq 0 ] && exit 0

  attempts=$((attempts + 1))
  if [ "$attempts" -ge "$RETRY_CAP" ]; then
    window=$(((now - first_seen) / 3600))
    reason="gave up after $attempts retries (~${window}h) — could not produce a digest for $vid ($title)"
    log "$reason"
    alert "$reason" "gave up on $vid"
    clear_pending
    exit 1
  fi
  delay=$((RETRY_BASE * (1 << attempts)))
  next=$((now + delay))
  write_pending captions "$vid" "$title" "$upload_date" "$first_seen" "$attempts" "$next"
  # Per-retry email only for the caption-lag case; summarization failure was
  # already alerted inside process_episode.
  if [ "$rc" -eq 10 ]; then
    reason="retry $attempts/$RETRY_CAP: captions still not ready for $vid ($title); next attempt in ~$((delay / 3600))h"
    log "$reason"
    alert "$reason" "retry $attempts — captions not ready"
  fi
  exit 1
fi

# --- discovery mode: find the newest long-form episode, send if new ------------
# Merge both tabs, keep rows over the duration floor, newest upload_date wins.
log "discovering latest episode on $CHANNEL (tabs: ${TABS[*]})"

# Cron run with no usable network (typical of a calendar job fired inside a
# dark-wake window on a sleeping laptop): park a discovery marker due
# immediately and let the hourly retry job take over once the machine is
# properly awake. No attempt is consumed and no alert is sent — an email
# couldn't get out either.
if [ "$FORCE" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && ! network_up; then
  now="$(now_epoch)"
  write_pending discovery "" "" "" "$now" 0 "$now"
  log "network unreachable; parked discovery for the hourly retry job"
  exit 1
fi

rc=0
selection="$(discover_latest)" || rc=$?
if [ "$rc" -ne 0 ]; then
  # Distinguish an empty fetch (yt-dlp/network failure) from a real "nothing
  # long-form recently" so the cron log is diagnosable.
  if [ "$rc" -eq 20 ]; then
    reason="discovery returned an empty listing (yt-dlp/network failure)"
  else
    reason="no episode over ${MIN_DURATION}s in the latest $SCAN_COUNT uploads per tab"
  fi
  log "$reason"
  if [ "$FORCE" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && [ "$rc" -eq 20 ]; then
    # An empty fetch is retryable; park it for the hourly job instead of losing
    # the week. A long-form-free listing is a fact about the channel, not a
    # failure — alert and stop.
    now="$(now_epoch)"
    write_pending discovery "" "" "" "$now" 0 "$((now + RETRY_BASE))"
    alert "$reason; scheduled hourly discovery retries (up to $RETRY_CAP)" "discovery failed — retrying"
  else
    alert "$reason" "no episode found"
  fi
  exit 1
fi

vid="$(printf '%s' "$selection" | cut -f2)"
upload_date="$(printf '%s' "$selection" | cut -f3)"
title="$(printf '%s' "$selection" | cut -f4-)"
log "latest episode: $vid — $title ($upload_date)"

# Idempotency guard.
mkdir -p "$STATE_DIR"
if [ "$FORCE" -eq 0 ] && [ -f "$STATE_FILE" ] && [ "$(cat "$STATE_FILE")" = "$vid" ]; then
  log "episode $vid already sent; nothing to do"
  clear_pending
  exit 0
fi

rc=0
process_episode "$vid" "$title" "$upload_date" || rc=$?
case "$rc" in
  0) exit 0 ;;
  10)
    # Captions aren't published yet. Manual runs just report it; a cron run parks
    # the episode so the hourly --retry-only job drains it with backoff.
    if [ "$FORCE" -eq 1 ] || [ "$DRY_RUN" -eq 1 ]; then
      log "no captions available yet for $vid; try again later"
      exit 1
    fi
    now="$(now_epoch)"
    write_pending "$vid" "$title" "$upload_date" "$now" 0 "$((now + RETRY_BASE))"
    reason="episode $vid ($title) detected but captions not ready; scheduled backoff retries (up to $RETRY_CAP over ~31h)"
    log "$reason"
    alert "$reason" "captions not ready — retrying"
    exit 1
    ;;
  *) exit 1 ;; # 11: summarization/delivery failed, already alerted
esac
