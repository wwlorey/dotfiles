#!/usr/bin/env bash
set -e

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "fatal: not a git repository (or any of the parent directories): .git"
  exit 1
fi

stage=false
push=false
amend=false

while [ $# -gt 0 ]; do
  case $1 in
    --stage) stage=true ;;
    --push) push=true ;;
    --amend) amend=true ;;
    -h | --help)
      echo "Usage: git commit-auto [--stage] [--push] [--amend]"
      echo ""
      echo "  --stage   Stage all changes (git add -A) before committing"
      echo "  --push    Push after committing"
      echo "  --amend   Amend the previous commit"
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
  shift
done

if $stage; then
  git add -A
fi

if ! $amend && git diff --staged --quiet; then
  echo "Nothing to commit."
  exit 0
fi

if $amend; then
  diff=$(git diff --staged)
  if [ -z "$diff" ]; then
    diff=$(git diff HEAD~1 HEAD)
  else
    diff="$diff

Previously committed:
$(git diff HEAD~1 HEAD)"
  fi
  status=$(git diff HEAD~1 HEAD --stat)
else
  diff=$(git diff --staged)
  status=$(git status --short)
fi

prompt="You are a commit message generator. Given the following git diff and status, write a single concise commit message.

Emit the commit message wrapped exactly between these two marker lines, each on its own line, and put nothing else between them:
<<<COMMIT>>>
the commit message here
<<<END>>>

Do not add quotes, markdown, bold, or a subject prefix inside the markers. Any commentary you write must be outside the markers.

git status:
$status

git diff:
$diff"

spin() {
  local chars='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  while true; do
    for ((i = 0; i < ${#chars}; i++)); do
      printf '\r%s Generating commit message...' "${chars:$i:1}"
      sleep 0.08
    done
  done
}

spin &
spin_pid=$!
trap 'kill $spin_pid 2>/dev/null; wait $spin_pid 2>/dev/null; printf "\r\033[K"' EXIT

errfile=$(mktemp)
msg=$(agent --bare -p "$prompt" --model haiku 2>"$errfile") || {
  kill $spin_pid 2>/dev/null || true
  wait $spin_pid 2>/dev/null || true
  trap - EXIT
  printf '\r\033[K'
  cat "$errfile" >&2
  rm -f "$errfile"
  echo "Failed to generate commit message:"
  echo "$msg"
  exit 1
}

kill $spin_pid 2>/dev/null || true
wait $spin_pid 2>/dev/null || true
trap - EXIT
printf '\r\033[K'

if [ -s "$errfile" ]; then
  cat "$errfile" >&2
fi
rm -f "$errfile"

# The model may wrap the message in commentary; keep only what's between the
# markers when they're present, otherwise fall back to the raw output.
if printf '%s' "$msg" | grep -q '<<<COMMIT>>>'; then
  msg=$(printf '%s\n' "$msg" | sed -n '/<<<COMMIT>>>/,/<<<END>>>/p' | sed '1d;$d')
fi

# Drop leading and trailing blank lines.
msg=$(printf '%s\n' "$msg" | awk '
  { lines[NR] = $0 }
  END {
    start = 1; end = NR
    while (start <= end && lines[start] ~ /^[[:space:]]*$/) start++
    while (end >= start && lines[end] ~ /^[[:space:]]*$/) end--
    for (i = start; i <= end; i++) print lines[i]
  }
')

if [ -z "$msg" ]; then
  echo "Failed to generate commit message."
  exit 1
fi

echo "Committing: $msg"
if $amend; then
  git commit --amend --only -m "$msg"
else
  git commit -m "$msg"
fi

if $push; then
  git push
fi
