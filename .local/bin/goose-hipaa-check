#!/usr/bin/env python3
"""Confirm a Goose config is HIPAA-locked to Google Vertex AI.

Goose is a full agentic harness (it edits files and runs shell commands), so
its compliance surface is wider than a chat client's: besides where the model
request goes, an MCP extension can open its own outbound channel, and usage
telemetry (PostHog) is on by default. This checker locks the NETWORK-EGRESS
axis — every model request stays inside your BAA-covered Vertex project, and
nothing else phones out. (Session persistence to the local SQLite DB is a
separate at-rest axis, handled by disk encryption + the gate's offer to wipe
stale sessions, not by this checker.)

Compliance invariant — ALL must hold in ~/.config/goose/config.yaml:

  1. GOOSE_PROVIDER is `gcp_vertex_ai` — the only Goose provider that routes to
     Google Vertex AI under your signed BAA. This REJECTS in particular the
     `google` / `gemini` provider (Google AI Studio, the consumer Generative
     Language API, NOT BAA-covered) plus openai / anthropic / databricks /
     bedrock / azure / ollama / openrouter (non-Vertex routes).

  2. GOOSE_MODEL names a declared GA model — no preview / experimental
     snapshots. GA models are what the Vertex BAA covers.

  3. GOOSE_TELEMETRY_ENABLED is false — no anonymous usage data leaves the
     machine (Goose's PostHog telemetry is opt-out and on by default).

  4. GCP_LOCATION is present (a real region). The project id is deliberately
     NOT in this file — the goose() gate injects it from
     $GOOGLE_CLOUD_HIPAA_PROJECT_ID at launch, so config.yaml is safe to commit
     publicly.

  5. GOOSE_MODE is present and not `auto` — a coding harness can exfiltrate PHI
     over the network via the shell commands it runs (curl/git), which no
     endpoint lock can prevent. A human-in-the-loop mode (approve / smart_approve
     / chat) keeps that egress from happening silently. Full autonomy (`auto`)
     is REJECTED.

  6. Every configured MCP extension is a LOCAL, no-network builtin from a small
     allowlist (developer, memory, tutorial). A stdio extension (whose `cmd` can
     be ANY command, e.g. a curl exfil pipe), a remote transport (sse /
     streamable_http / http), or an unlisted builtin is an off-BAA egress path
     and is REJECTED. Gating on transport type alone is insufficient — a
     "local" stdio extension is an arbitrary command — so this gates on the
     builtin NAME.

Exit status: 0 = locked, 1 = violations found, 2 = usage/parse error.

`--list-models` prints the GA model allowlist (one per line) instead of
checking — the zsh gate uses this to surface allowed models on a violation.

Usage: goose-hipaa-check [--list-models] [path/to/config.yaml]
Default: ~/.config/goose-hipaa/config/config.yaml (the gate's pinned root)

NOTE: the exact provider id (`gcp_vertex_ai`) and model names should be
confirmed once against `goose configure`'s live provider/model list — they are
Goose's published identifiers but were not verified against an installed binary
when this was written. A mismatch surfaces immediately on the first launch.
"""

from __future__ import annotations

import os
import sys

import yaml

ALLOWED_PROVIDERS = {"gcp_vertex_ai"}

# GA Vertex models covered by the BAA (mirrors the aichat allowlist). Extend
# this set to widen what GOOSE_MODEL may name; keep every entry GA.
GA_MODELS = {
    "gemini-3.5-flash",       # GA on Vertex 2026-05-19; global-endpoint-only here
    "gemini-2.5-pro",
    "gemini-2.5-flash",
    "gemini-2.5-flash-lite",
}

NON_GA_MARKERS = (
    "preview", "-exp", "experimental", "nightly", "-rc", "-test", "beta",
    "latest",
)

# Extensions are locked to a small allowlist of LOCAL, no-network builtins.
# Everything else — any stdio extension (an arbitrary command, e.g. a curl
# pipe), any remote transport (sse/http/streamable_http), or an unlisted
# builtin (e.g. computercontroller, which browses the web) — is an off-BAA
# egress path and is REJECTED. Inspecting a stdio extension's transport alone
# is not enough (its `cmd` can be any exfil tool), so the allowlist gates on the
# builtin NAME, not the transport type.
ALLOWED_BUILTIN_EXTENSIONS = {"developer", "memory", "tutorial"}

DEFAULT_CONFIG = os.path.expanduser("~/.config/goose-hipaa/config/config.yaml")

# Human-in-the-loop modes: the harness pauses for approval before acting. `auto`
# (full autonomy) is rejected; an absent mode is rejected (fail closed).
ALLOWED_MODES = {"approve", "smart_approve", "chat"}


def _non_ga(name: str) -> bool:
    low = str(name).lower()
    return any(marker in low for marker in NON_GA_MARKERS)


def _iter_extensions(cfg: dict):
    """Yield (label, spec) for each configured extension, tolerating both the
    map form (extensions: {name: {...}}) and a list form."""
    exts = cfg.get("extensions")
    if isinstance(exts, dict):
        for name, spec in exts.items():
            yield str(name), (spec if isinstance(spec, dict) else {})
    elif isinstance(exts, list):
        for i, spec in enumerate(exts):
            spec = spec if isinstance(spec, dict) else {}
            yield str(spec.get("name") or f"#{i}"), spec


def check(cfg: dict) -> list[str]:
    problems: list[str] = []

    provider = cfg.get("GOOSE_PROVIDER")
    if provider not in ALLOWED_PROVIDERS:
        hint = ""
        if provider in ("google", "gemini"):
            hint = " ('google'/'gemini' = Google AI Studio, NOT BAA-covered)"
        problems.append(
            f"GOOSE_PROVIDER is '{provider}' — only 'gcp_vertex_ai' routes to "
            f"your BAA-covered Vertex project{hint}"
        )

    model = cfg.get("GOOSE_MODEL")
    if not model:
        problems.append("no GOOSE_MODEL declared — pin a GA Vertex model")
    elif _non_ga(model):
        problems.append(
            f"GOOSE_MODEL '{model}' looks non-GA (preview/experimental) — GA "
            f"only under the BAA"
        )
    elif model not in GA_MODELS:
        problems.append(
            f"GOOSE_MODEL '{model}' is not in the GA allowlist — "
            f"allowed: {', '.join(sorted(GA_MODELS))}"
        )

    tele = cfg.get("GOOSE_TELEMETRY_ENABLED", True)
    if tele is not False:
        problems.append(
            "GOOSE_TELEMETRY_ENABLED is not false — Goose's PostHog usage "
            "telemetry would egress. Set it to false."
        )

    if not cfg.get("GCP_LOCATION"):
        problems.append(
            "no GCP_LOCATION declared — pin the Vertex region (e.g. us-central1)"
        )

    mode = cfg.get("GOOSE_MODE")
    if mode not in ALLOWED_MODES:
        problems.append(
            f"GOOSE_MODE is '{mode}' — a harness runs shell commands that can "
            f"exfiltrate PHI, so it must stay human-in-the-loop. Set one of "
            f"{', '.join(sorted(ALLOWED_MODES))} (not 'auto')."
        )

    # goose reads TLS/proxy overrides (GOOSE_CA_CERT_PATH, GOOSE_CLIENT_CERT_PATH/
    # KEY, proxy vars) from config OR env. The zsh gate refuses the env form, but
    # a value placed in config.yaml (drift, `goose configure`, a bad commit) is
    # invisible to the gate — a rogue CA/client cert makes a MITM proxy's cert
    # trusted for the Vertex TLS connection (PHI decryptable in transit), and a
    # proxy reroutes it. Reject any such key by shape, so renames don't reopen it.
    # goose reads trace exporters (OTEL/OTLP, Langfuse — both ship prompt/
    # response content) and per-provider host/base-url/endpoint overrides from
    # config OR env. The zsh gate refuses the env form; a value placed in
    # config.yaml (drift, `goose configure`, a bad commit) is invisible to the
    # gate, so reject it here by shape too.
    for key in cfg:
        up = str(key).upper()
        if any(m in up for m in ("PROXY", "CERT", "CA_BUNDLE")):
            problems.append(
                f"config key '{key}' can redirect or expose PHI in transit "
                f"(proxy / CA / client-cert override) — remove it"
            )
        elif any(m in up for m in ("OTEL", "OTLP", "LANGFUSE")):
            problems.append(
                f"config key '{key}' configures LLM trace export (OTLP / "
                f"Langfuse), which ships prompts/responses (PHI) off-machine "
                f"— remove it"
            )
        elif up.endswith(("_HOST", "_BASE_URL")) or "ENDPOINT" in up:
            problems.append(
                f"config key '{key}' can point the model provider at a "
                f"non-Vertex host/endpoint — remove it"
            )

    for label, spec in _iter_extensions(cfg):
        etype = str(spec.get("type", "")).lower()
        if etype == "builtin":
            name = str(spec.get("name") or label).lower()
            if name not in ALLOWED_BUILTIN_EXTENSIONS:
                problems.append(
                    f"extension '{label}' is builtin '{name}' — only local, "
                    f"no-network builtins are permitted "
                    f"({', '.join(sorted(ALLOWED_BUILTIN_EXTENSIONS))})"
                )
        else:
            # stdio (arbitrary command) or any remote transport — off-BAA egress.
            problems.append(
                f"extension '{label}' has type '{etype or '(unset)'}' — only "
                f"local builtin extensions "
                f"({', '.join(sorted(ALLOWED_BUILTIN_EXTENSIONS))}) are "
                f"permitted; stdio/remote extensions are off-BAA egress paths"
            )

    return problems


def main() -> int:
    args = sys.argv[1:]
    list_models = "--list-models" in args
    if list_models:
        args.remove("--list-models")
        for name in sorted(GA_MODELS):
            print(name)
        return 0

    path = args[0] if args else DEFAULT_CONFIG
    try:
        with open(path) as f:
            cfg = yaml.safe_load(f) or {}
    except FileNotFoundError:
        print(f"goose-hipaa-check: config not found: {path}", file=sys.stderr)
        return 2
    except yaml.YAMLError as exc:
        print(f"goose-hipaa-check: invalid YAML in {path}: {exc}", file=sys.stderr)
        return 2

    if not isinstance(cfg, dict):
        print(f"goose-hipaa-check: {path} is not a YAML mapping", file=sys.stderr)
        return 2

    problems = check(cfg)
    if problems:
        print(f"✗ NOT HIPAA-locked: {path}")
        for p in problems:
            print(f"  - {p}")
        return 1

    print(
        f"✓ HIPAA-locked (Vertex-only, GA model, telemetry off, "
        f"human-in-the-loop, no remote extensions): {path}"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
